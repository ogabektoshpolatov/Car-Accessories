@using System.Security.Cryptography
@using CarAccessories.Application.Interfaces
@inherits LayoutComponentBase
@inject ICategoryService CategoryService

<RadzenLayout style="position: relative">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel Text="Header" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar Responsive="true" @bind-Expanded="@sidebarExpanded" style="position: absolute">
        <RadzenPanelMenu>
            @if (categories != null)
            {
                @foreach (var category in categories)
                {
                    <RadzenPanelMenuItem Text="@category.Name" />
                }
            }
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
    <RadzenFooter>
        Footer
    </RadzenFooter>
</RadzenLayout>

@code {
    bool sidebarExpanded = true;
    
}
